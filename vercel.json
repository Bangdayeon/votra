{
  "buildCommand": "npm run db:deploy && npx tsx scripts/seed-skills.ts && npm run build",
  "crons": [
    {
      "path": "/api/cron/auto-refresh",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/memory-decay",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/memory-reflection",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/cleanup-ingests",
      "schedule": "0 4 * * *"
    }
  ]
}
