// Votra — Prisma Schema
// DB: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────

enum AgentSource {
  CLAUDE
  CURSOR
  CODEX
  // 추후 확장
}

enum ProjectRole {
  OWNER
  VIEWER
}

// ────────────────────────────────────────────
// USER
// ────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  /// bcrypt 해시. axhub SSO 가입자 등 비밀번호 미설정 사용자는 null
  passwordHash String?
  /// axhub 플랫폼의 사용자 식별자. axhub SSO 로 가입/연결되면 채워짐
  axhubUserId  String? @unique

  /// 프로필 색상 (hex without #) 또는 프로필 이미지 경로 중 하나만 사용
  profileColor String?
  /// public 폴더 기준 이미지 경로 (예: /assets/images/profile_dog.png)
  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  projectMembers ProjectMember[]
}

// ────────────────────────────────────────────
// PROJECT
// ────────────────────────────────────────────

model Project {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String? // Cloudflare R2 URL

  // 폴더 스트럭처 / 아키텍처 정보
  // 자유도 높은 구조이므로 JSON으로 저장
  // e.g. { "tree": [...], "architecture": "..." }
  structure Json?

  /// 로컬 폴더 절대경로 (예: "/Users/bibi/votra"). 파일 경로 표시 시 base prefix
  cwd String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members  ProjectMember[]
  agents   ProjectAgent[]
  sessions Session[]

  @@index([ownerId])
}

// ────────────────────────────────────────────
// PROJECT MEMBER (팀 확장 대비)
// ────────────────────────────────────────────

model ProjectMember {
  id       String      @id @default(cuid())
  role     ProjectRole @default(VIEWER)
  joinedAt DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT AGENT (사용한 AI agent 배열)
// ────────────────────────────────────────────

model ProjectAgent {
  id     String      @id @default(cuid())
  source AgentSource
  // agent별 부가 정보 (model명, version 등)
  // e.g. { "model": "claude-opus-4-5", "version": "..." }
  meta   Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source]) // 프로젝트당 agent 중복 방지
  @@index([projectId])
}

// ────────────────────────────────────────────
// SESSION
// ────────────────────────────────────────────

model Session {
  id        String      @id @default(cuid())
  title     String?
  source    AgentSource
  model     String // e.g. "claude-opus-4-5", "claude-sonnet-4-5"
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tokenUsage SessionTokenUsage?
  events     Event[]
  errorFlows SessionErrorFlow[]

  @@index([projectId])
}

// ────────────────────────────────────────────
// SESSION TOKEN USAGE
// 추후 필드 추가/수정 용이하도록 Session과 1:1 분리
// ────────────────────────────────────────────

model SessionTokenUsage {
  id String @id @default(cuid())

  // 기본 토큰
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  // retry 비용
  retryCount        Int @default(0)
  retryInputTokens  Int @default(0)
  retryOutputTokens Int @default(0)
  retryTotalTokens  Int @default(0)

  // 비용 추정 (USD, 소수점 6자리까지)
  estimatedCostUsd Decimal? @db.Decimal(10, 6)

  // model별 usage 상세 (여러 모델 혼용 대비 JSON)
  // e.g. [{ "model": "claude-opus-4-5", "inputTokens": 100, "outputTokens": 200 }]
  modelBreakdown Json?

  updatedAt DateTime @updatedAt

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// SESSION ERROR FLOW
// 세션 안에서 발생한 에러 + 해결 흐름 (retry / rollback / 수정 단계)
// 통계 (에러 횟수) 는 COUNT 쿼리로 산출
// ────────────────────────────────────────────

model SessionErrorFlow {
  id String @id @default(cuid())

  // 에러 분류 — "TypeError", "ToolCallError", "ValidationError", "BuildError" 등
  errorType    String
  errorMessage String? @db.Text

  occurredAt DateTime  @default(now())
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  // 어떻게 고쳤는지: 단계 배열 (자유도 높은 흐름이라 JSON)
  // e.g. [
  //   { "action": "edit_file", "path": "src/x.ts", "reason": "..." },
  //   { "action": "retry", "attempt": 1 },
  //   { "action": "rollback", "to_commit": "abc1234" }
  // ]
  fixFlow Json?

  retryCount Int     @default(0) // 이 에러 해결까지 발생한 retry 횟수
  rolledBack Boolean @default(false) // rollback 으로 해결됐는지

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, resolved])
}

// ────────────────────────────────────────────
// EVENT (세션 내 개별 이벤트)
// ────────────────────────────────────────────

enum EventType {
  /// 사용자가 입력한 프롬프트
  PROMPT
  /// 어시스턴트의 응답 메시지
  ASSISTANT
  /// 툴 호출 (Read / Edit / Bash / WebFetch 등)
  TOOL_CALL
  /// 파일 편집 결과 (path + diff/before-after)
  FILE_EDIT
  /// 에러 발생 (TypeError, ToolCallError, ValidationError …) — SessionErrorFlow 와 연결
  ERROR
  /// git commit 이 발생한 시점 (sha + message)
  COMMIT
  /// 시스템 메시지 (init, env, hook 등 사용자/어시스턴트 외 출처)
  SYSTEM
  /// 세션 메타 (title 변경, model 변경, source 변경 등)
  SESSION_META
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  role      String? // "user" | "assistant" | "system" | "developer"
  content   String?   @db.Text
  timestamp DateTime

  // 파일경로, toolName, errorType, tokens 등 이벤트별 부가 데이터
  metadata Json?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, type])
  @@index([timestamp])
}
