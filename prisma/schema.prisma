// Haema — Prisma Schema
// DB: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MemoryTier {
  ACTIVE
  LONG_TERM
  ARCHIVED
  TRASH
}

// ────────────────────────────────────────────
// USER
// ────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  /// bcrypt 해시. axhub SSO 가입자 등 비밀번호 미설정 사용자는 null
  passwordHash String?
  /// axhub 플랫폼의 사용자 식별자. axhub SSO 로 가입/연결되면 채워짐
  axhubUserId  String? @unique
  /// Google OAuth 사용자 식별자. Google 로그인으로 가입/연결되면 채워짐
  googleId     String? @unique

  /// 프로필 색상 (hex without #) 또는 프로필 이미지 경로 중 하나만 사용
  profileColor String?
  /// public 폴더 기준 이미지 경로 (예: /assets/images/profile_dog.png)
  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects           Project[]
  projectMembers     ProjectMember[]
  apiKeys            ApiKey[]
  sentInvites        ProjectInvite[] @relation("InvitedByUser")
  acceptedInvites    ProjectInvite[] @relation("AcceptedByUser")
  tasks              Task[]
  taskFolders        TaskFolder[]
  sessionLogs        SessionLog[]
  tools              ProjectTool[]
  commands           ProjectCommand[]
}

// ────────────────────────────────────────────
// API KEY (CLI 등 외부 클라이언트 인증)
// ────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(cuid())
  name         String
  /// sha256(plaintext) hex. 평문은 생성 시 1회만 사용자에게 노출.
  hashedSecret String    @unique
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT
// ────────────────────────────────────────────

model Project {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String? // Cloudflare R2 URL

  // 폴더 스트럭처 / 아키텍처 정보
  // 자유도 높은 구조이므로 JSON으로 저장
  // e.g. { "tree": [...], "architecture": "..." }
  structure Json?

  /// 로컬 폴더 절대경로 (예: "/Users/bibi/haema"). 파일 경로 표시 시 base prefix
  cwd String?

  /// 프로젝트별 설정 (유형, AI 분석 옵션 등). domain/project/settings/types.ts 의 ProjectSettings 와 동기화.
  settings Json?

  sortOrder  Float   @default(0)
  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members              ProjectMember[]
  agents               ProjectAgent[]
  aiSummary            ProjectAiSummary?
  aiNextTask           ProjectAiNextTask?
  invites              ProjectInvite[]
  tasks                Task[]
  taskFolders          TaskFolder[]
  memoryReflections    ProjectMemoryReflection[]
  memoryContext        ProjectMemoryContext?
  tools                ProjectTool[]
  sessionLogs          SessionLog[]

  @@unique([ownerId, cwd])
  @@index([ownerId])
}

// ────────────────────────────────────────────
// PROJECT AI SUMMARY (개요 페이지 AI 요약/솔루션 캐시)
// 사용자가 "업데이트" 버튼을 누를 때만 갱신. 토큰 절약 목적.
// ────────────────────────────────────────────

model ProjectAiSummary {
  id String @id @default(cuid())

  /// LLM 이 생성한 요약 본문 (한국어)
  summary String @db.Text

  /// LLM 이 생성한 주의사항 목록. [{ message, agentCommand }]
  warnings Json @default("[]")
  /// LLM 이 생성한 제안 목록. [{ message, agentCommand }]
  suggestions Json @default("[]")

  /// 마지막 갱신 시각 (사용자에게 표시)
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// PROJECT AI NEXT TASK (AI 추천 다음 작업)
// 사용자가 "업데이트" 버튼을 누를 때만 갱신. 토큰 절약 목적.
// ────────────────────────────────────────────

model ProjectAiNextTask {
  id String @id @default(cuid())

  /// LLM 이 생성한 다음 작업 목록 (1~3개 문자열 배열)
  tasks Json @default("[]")

  /// 마지막 갱신 시각
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// PROJECT MEMBER (팀 확장 대비)
// ────────────────────────────────────────────

model ProjectMember {
  id       String      @id @default(cuid())
  role     ProjectRole @default(MEMBER)
  joinedAt DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT INVITE (팀원 초대 링크)
// ────────────────────────────────────────────

model ProjectInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  expiresAt   DateTime
  acceptedAt  DateTime?

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedByUser", fields: [invitedById], references: [id])

  acceptedById String?
  acceptedBy   User?  @relation("AcceptedByUser", fields: [acceptedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([token])
}

// ────────────────────────────────────────────
// PROJECT AGENT (사용한 AI agent 배열)
// ────────────────────────────────────────────

model ProjectAgent {
  id     String @id @default(cuid())
  source String
  // agent별 부가 정보 (model명, version 등)
  // e.g. { "model": "claude-opus-4-5", "version": "..." }
  meta   Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source]) // 프로젝트당 agent 중복 방지
  @@index([projectId])
}

// ────────────────────────────────────────────
// POLICY RULE (AI 정책 평가 규칙 — 시스템 기본값)
// 사용자/팀이 따로 덮어쓰기 전까지 모든 프로젝트가 공유하는 평가 항목.
// ────────────────────────────────────────────

model PolicyRule {
  id String @id @default(cuid())

  /// 규칙 식별자 키 ("commands" | "architecture" | "patterns" | "conciseness" | "currency" | "actionability")
  key String @unique

  /// 사용자에게 보여줄 한국어 라벨
  label String

  /// 이 규칙이 무엇을 평가하는지 한 줄 설명 — 파일 점수 옆에 "왜" 컨텍스트로 노출
  description String @db.Text

  /// 이 규칙의 만점 (현재 휴리스틱은 20 또는 15)
  maxPoints Int

  /// 화면 정렬 순서 (작을수록 위)
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// TASK FOLDER (태스크 그루핑용 폴더)
// folderId가 null인 태스크는 기본 그룹(미분류)으로 표시
// ────────────────────────────────────────────

model TaskFolder {
  id        String   @id @default(cuid())
  name      String
  /// lucide 아이콘 이름 (null = 기본 폴더)
  icon      String?
  /// 폴더 색상 키워드 (null = 기본 색상)
  color     String?
  /// 폴더 내 정렬 순서 (작을수록 위, 0=미설정)
  sortOrder Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([projectId])
  @@index([userId])
}

// ────────────────────────────────────────────
// TASK (세션 간 태스크 관리 + 핵심 결정 저장)
// ────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  /// 사람이 읽기 쉬운 순번. MCP tool에서 #42 형태로 참조.
  seq         Int        @unique @default(autoincrement())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  /// 작업 툴 슬러그 (예: "devops", "frontend", "backend"). 필터링에 사용.
  tool        String?
  priority    Int        @default(0)
  /// UI 드래그앤드롭 수동 정렬 순서. 0=미설정(맨 뒤).
  sortOrder   Float      @default(0)
  /// finish_task 시 AI가 추출한 핵심 결정/인사이트 목록. recall 검색 대상.
  keyDecisions String[]   @default([])
  /// finish_task 시 AI가 자유 서술로 기록한 "실제로 무엇을 했는지"
  outcome      String?    @db.Text
  /// status 가 DONE/CANCELLED 로 바뀐 시각
  doneAt      DateTime?
  /// 휴지통 이동 시각. null 이면 활성 태스크. 12일 후 영구 삭제.
  deletedAt   DateTime?
  /// AI 메모리 감쇠 계층. ACTIVE=기본, LONG_TERM=영구보존, ARCHIVED=장기보관, TRASH=감쇠 대기
  memoryTier     MemoryTier @default(ACTIVE)
  /// MCP recall/task_detail/brief 호출 시 누적 접근 횟수
  accessCount    Int        @default(0)
  /// 마지막으로 MCP 툴에서 참조된 시각
  lastAccessedAt DateTime?
  /// 사용자가 장기 기억으로 명시 고정. LONG_TERM 강제 유지.
  isPinned       Boolean    @default(false)
  /// 벡터 임베딩 (text-embedding-004, 768차원). 태스크 완료 시 비동기 생성.
  embedding      Unsupported("vector(3072)")?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    TaskFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, tool])
  @@index([projectId, folderId])
  @@index([projectId, deletedAt])
  @@index([projectId, memoryTier])
  @@index([projectId, lastAccessedAt])
  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT MEMORY CONTEXT (AI 성장형 프로젝트 맥락 기억)
// 태스크에서 추출한 맥락을 plain text로 누적 저장.
// 프로젝트당 1개. 학습할 때마다 갱신되며 version이 올라감.
// ────────────────────────────────────────────

model ProjectMemoryContext {
  id        String @id @default(cuid())
  projectId String @unique

  /// AI가 태스크 학습을 통해 축적한 프로젝트 맥락 (하위 호환 유지, 추후 제거 예정)
  content   String @db.Text
  /// 몇 번째 갱신인지. 유저가 저장할 때마다 +1.
  version   Int    @default(1)

  /// 유저가 직접 관리하는 프로젝트 헌법 (4개 필드)
  serviceDescription String? @db.Text
  techStack          String? @db.Text
  targetUsers        String? @db.Text
  currentGoal        String? @db.Text

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// PROJECT MEMORY REFLECTION (AI 메모리 반성 스냅샷)
// finish_task N회 누적 또는 cron 에 의해 자동 생성.
// ────────────────────────────────────────────

model ProjectMemoryReflection {
  id        String @id @default(cuid())

  /// AI가 분석한 인사이트 목록. [{type:"pattern"|"insight"|"risk", text}]
  insights  Json @default("[]")
  /// AI 추천 태스크 목록. [{title, reason, priority:"high"|"medium"|"low"}]
  suggestedTasks Json @default("[]")
  /// AI가 생성한 프로젝트 컨텍스트 요약. brief에서 LONG_TERM 태스크와 함께 활용.
  contextSummary String? @db.Text
  /// AI가 제안한 커스텀 툴 목록. [{name, description, folder, content, patternSummary}]
  toolSuggestions Json @default("[]")
  /// AI가 기존 툴에 보강을 제안한 목록. [{targetToolName, addToContent, reason}]
  toolEnrichments Json @default("[]")
  /// 분석에 사용된 태스크 수
  analyzedTaskCount Int @default(0)
  /// 트리거 원인: "cron" | "threshold"
  triggerReason String @default("cron")

  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ────────────────────────────────────────────
// PROJECT TOOL (커스텀 툴 — 글로벌 또는 프로젝트 종속)
// projectId = null  → 유저 글로벌 툴 (모든 프로젝트에서 사용)
// projectId = 설정  → 프로젝트 전용 툴 (AI 리플렉션 자동 생성)
// ────────────────────────────────────────────

model ProjectTool {
  id             String   @id @default(cuid())
  slug           String
  name           String
  description    String
  /// 툴 그룹 폴더명 (UI에서 그룹핑)
  folder         String   @default("기타")
  content        String   @db.Text
  /// AI가 감지한 패턴 요약 (AI 추천 출처인 경우에만)
  patternSummary String?  @db.Text
  /// 이 툴을 언제 사용해야 하는지 트리거 힌트 (brief에서 에이전트에게 노출)
  contextHint    String?  @db.Text
  /// Claude Code 훅 이벤트 종류 (null = 맥락형 툴)
  hookEvent      String?
  /// 훅이 반응하는 툴 이름 (e.g. "Edit", "Bash", "mcp__haema-memory__finish_task")
  hookMatcher    String?
  /// 훅 실행 시 실행될 bash 스크립트 본문
  hookScript     String?  @db.Text
  isEnabled      Boolean  @default(true)
  isBuiltIn      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([userId])
  @@index([projectId])
}

// ────────────────────────────────────────────
// PROJECT COMMAND (유저 정의 슬래시 커맨드 — 글로벌)
// 유저가 직접 만드는 /명령어. 모든 프로젝트에서 공유.
// AI가 자동 생성하면 안 됨 (Tool과 달리).
// ────────────────────────────────────────────

model ProjectCommand {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String
  /// 커맨드 그룹 폴더명 (UI에서 그룹핑)
  folder      String   @default("기타")
  content     String   @db.Text
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

// ────────────────────────────────────────────
// SESSION LOG (세션 종료 시 AI 작업 맥락 SOP 기록)
// ────────────────────────────────────────────

model SessionLog {
  id        String   @id @default(cuid())
  /// LLM이 구조화한 SOP 마크다운 (상황/요구사항/작업/결과)
  summary   String   @db.Text
  aiTool    String   @default("unknown")
  sessionId String?
  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
}
