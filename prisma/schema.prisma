// Votra — Prisma Schema
// DB: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

// ────────────────────────────────────────────
// USER
// ────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  /// bcrypt 해시. axhub SSO 가입자 등 비밀번호 미설정 사용자는 null
  passwordHash String?
  /// axhub 플랫폼의 사용자 식별자. axhub SSO 로 가입/연결되면 채워짐
  axhubUserId  String? @unique
  /// Google OAuth 사용자 식별자. Google 로그인으로 가입/연결되면 채워짐
  googleId     String? @unique

  /// 프로필 색상 (hex without #) 또는 프로필 이미지 경로 중 하나만 사용
  profileColor String?
  /// public 폴더 기준 이미지 경로 (예: /assets/images/profile_dog.png)
  profileImage String?

  /// 계정 전체 (모든 프로젝트) 에 적용할 AI 활용 정책 본문 (자유 텍스트).
  aiPolicyText        String? @db.Text
  /// 정책 파일 업로드 시 원본 파일명 (예: "company-ai-policy.md")
  aiPolicyFileName    String?
  /// 정책 파일 본문 (텍스트, 512KB 캡)
  aiPolicyFileContent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects           Project[]
  projectMembers     ProjectMember[]
  apiKeys            ApiKey[]
  sentInvites        ProjectInvite[] @relation("InvitedByUser")
  acceptedInvites    ProjectInvite[] @relation("AcceptedByUser")
  tasks              Task[]
  taskFolders        TaskFolder[]
  sessionLogs        SessionLog[]
}

// ────────────────────────────────────────────
// API KEY (CLI 등 외부 클라이언트 인증)
// ────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(cuid())
  name         String
  /// sha256(plaintext) hex. 평문은 생성 시 1회만 사용자에게 노출.
  hashedSecret String    @unique
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT
// ────────────────────────────────────────────

model Project {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String? // Cloudflare R2 URL

  // 폴더 스트럭처 / 아키텍처 정보
  // 자유도 높은 구조이므로 JSON으로 저장
  // e.g. { "tree": [...], "architecture": "..." }
  structure Json?

  /// 로컬 폴더 절대경로 (예: "/Users/bibi/votra"). 파일 경로 표시 시 base prefix
  cwd String?

  /// 프로젝트별 설정 (유형, AI 분석 옵션 등). domain/project/settings/types.ts 의 ProjectSettings 와 동기화.
  settings Json?

  /// AI 가 프로젝트의 md 파일(CLAUDE.md, AGENTS.md 등)을 평가할 때 따를 사용자 지침. 자유 텍스트.
  aiSpecGuideline String? @db.Text

  /// 사용자가 업로드한 AI 스펙 보조 파일 이름 (한 프로젝트에 1개). 없으면 null.
  aiSpecFileName    String?
  /// 업로드 파일의 텍스트 본문. 텍스트 파일을 가정하고 그대로 보관 (~512KB cap).
  aiSpecFileContent String? @db.Text

  /// AI 프롬프트 흐름 진단에 사용할 기본 프롬프트. 비워두면 시스템 기본 프롬프트 사용.
  agentContextFlowPrompt String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members              ProjectMember[]
  agents               ProjectAgent[]
  claudeFiles          ClaudeFile[]
  claudeFileEvaluations ClaudeFileEvaluation[]
  aiSummary            ProjectAiSummary?
  aiNextTask           ProjectAiNextTask?
  agentContextFlowDiagnosis ProjectAgentContextFlowDiagnosis?
  invites              ProjectInvite[]
  tasks                Task[]
  taskFolders          TaskFolder[]
  sessionLogs          SessionLog[]
  skillConfigs         ProjectSkillConfig[]

  @@unique([ownerId, cwd])
  @@index([ownerId])
}

// ────────────────────────────────────────────
// PROJECT AI SUMMARY (개요 페이지 AI 요약/솔루션 캐시)
// 사용자가 "업데이트" 버튼을 누를 때만 갱신. 토큰 절약 목적.
// ────────────────────────────────────────────

model ProjectAiSummary {
  id String @id @default(cuid())

  /// LLM 이 생성한 요약 본문 (한국어)
  summary String @db.Text

  /// LLM 이 생성한 주의사항 목록. [{ message, agentCommand }]
  warnings Json @default("[]")
  /// LLM 이 생성한 제안 목록. [{ message, agentCommand }]
  suggestions Json @default("[]")

  /// 마지막 갱신 시각 (사용자에게 표시)
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// PROJECT AI NEXT TASK (AI 추천 다음 작업)
// 사용자가 "업데이트" 버튼을 누를 때만 갱신. 토큰 절약 목적.
// ────────────────────────────────────────────

model ProjectAiNextTask {
  id String @id @default(cuid())

  /// LLM 이 생성한 다음 작업 목록 (1~3개 문자열 배열)
  tasks Json @default("[]")

  /// 마지막 갱신 시각
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// PROJECT MEMBER (팀 확장 대비)
// ────────────────────────────────────────────

model ProjectMember {
  id       String      @id @default(cuid())
  role     ProjectRole @default(MEMBER)
  joinedAt DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ────────────────────────────────────────────
// PROJECT INVITE (팀원 초대 링크)
// ────────────────────────────────────────────

model ProjectInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  expiresAt   DateTime
  acceptedAt  DateTime?

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedByUser", fields: [invitedById], references: [id])

  acceptedById String?
  acceptedBy   User?  @relation("AcceptedByUser", fields: [acceptedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([token])
}

// ────────────────────────────────────────────
// PROJECT AGENT (사용한 AI agent 배열)
// ────────────────────────────────────────────

model ProjectAgent {
  id     String @id @default(cuid())
  source String
  // agent별 부가 정보 (model명, version 등)
  // e.g. { "model": "claude-opus-4-5", "version": "..." }
  meta   Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source]) // 프로젝트당 agent 중복 방지
  @@index([projectId])
}

// ────────────────────────────────────────────
// CLAUDE FILE (AI 동작에 영향을 주는 파일)
// CLAUDE.md / AGENTS.md / SKILL.md 등을 사용자 머신에서 스캔해 DB 에 적재.
// 대시보드는 fs 가 아닌 이 테이블만 읽으므로 배포 환경에서도 동작.
// ────────────────────────────────────────────

model ClaudeFile {
  id String @id @default(cuid())

  /// "CLAUDE" | "AGENTS" | "SKILL" — domain/claudeFiles/types.ts 의 ClaudeFileKind 와 동기화
  kind String
  /// "global" | "project-root" | "subdir" — ClaudeFileScope 와 동기화
  scope String

  /// 사용자 머신 기준 절대 경로
  absPath     String
  /// scope 안에서의 보기용 경로
  displayPath String
  /// 파일 본문 (256KB 캡)
  content     String @db.Text
  /// epoch ms — currency 점수 계산 입력
  mtimeMs     BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, absPath])
  @@index([projectId])
}

// ────────────────────────────────────────────
// CLAUDE FILE EVALUATION (AI 정책 문서 평가 상태)
// 한 ClaudeFile 의 마지막 평가 결과/진행 상태를 캐싱.
// (projectId, absPath) 로 키잉해 ClaudeFile 재인제스트에도 살아남게 함.
// ────────────────────────────────────────────

model ClaudeFileEvaluation {
  id String @id @default(cuid())

  /// "PENDING" | "LOADING" | "DONE" | "ERROR" — domain 의 ClaudeFileEvaluationStatus 와 동기화
  status String

  /// "OK" | "WARNING" | "DANGER" — status=DONE 일 때만 채워짐
  severity String?

  /// status=ERROR 일 때 사용자에게 보여줄 사유
  errorMessage String? @db.Text

  /// LLM 이 돌려준 한국어 해설 — "왜 이 평가가 됐는지" 설명. status=DONE 일 때 사용.
  aiReason String? @db.Text

  /// LLM 이 채점한 PolicyRule.key → 점수 매핑. e.g. { "commands": 18, "architecture": 12, ... }
  scoresJson Json?

  /// LLM 이 생성한 항목별 개선 제안. 점수가 낮은 항목만 포함. e.g. { "commands": "npm run dev 를 코드 펜스로 추가해보세요." }
  suggestionsJson Json?

  /// 평가 기준 적용 여부 — 사용자가 어떤 기준으로 통과/탈락 판단됐는지 캡션에 사용
  basedOnBasic   Boolean @default(true)
  basedOnProject Boolean @default(false)
  basedOnTeam    Boolean @default(false)

  /// 평가 당시 사용자의 "전체 정책" 내용 해시 (sha256 head). 변경되면 재평가 트리거.
  globalPolicyHash String?
  /// 전체 정책 위반 시 LLM 이 적은 한 줄 문제 진술. 위반 없으면 null.
  globalPolicyProblem String? @db.Text
  /// 전체 정책 위반 시 LLM 이 적은, 사용자가 AI agent 에 그대로 붙여 넣어 고치게 할 명령어. 위반 없으면 null.
  globalPolicyAgentCommand String? @db.Text

  /// 평가가 끝난 시각 (DONE/ERROR 진입 시각)
  evaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// ClaudeFile.absPath 와 매칭. ClaudeFile 재인제스트로 row id 가 바뀌어도 평가 결과는 유지됨.
  absPath String

  @@unique([projectId, absPath])
  @@index([projectId])
}

// ────────────────────────────────────────────
// PROJECT AGENT CONTEXT FLOW DIAGNOSIS (AI 지시 문서 흐름 진단 캐시)
// 사용자가 "업데이트" 버튼을 누를 때만 갱신.
// ────────────────────────────────────────────

model ProjectAgentContextFlowDiagnosis {
  id String @id @default(cuid())

  /// LLM 이 생성한 진단 결과 (마크다운 형식)
  result String @db.Text

  /// 마지막 갱신 시각
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────
// POLICY RULE (AI 정책 평가 규칙 — 시스템 기본값)
// 사용자/팀이 따로 덮어쓰기 전까지 모든 프로젝트가 공유하는 평가 항목.
// ────────────────────────────────────────────

model PolicyRule {
  id String @id @default(cuid())

  /// 도메인 ClaudeFileScore 키와 1:1 매칭 ("commands" | "architecture" | "patterns" | "conciseness" | "currency" | "actionability")
  key String @unique

  /// 사용자에게 보여줄 한국어 라벨
  label String

  /// 이 규칙이 무엇을 평가하는지 한 줄 설명 — 파일 점수 옆에 "왜" 컨텍스트로 노출
  description String @db.Text

  /// 이 규칙의 만점 (현재 휴리스틱은 20 또는 15)
  maxPoints Int

  /// 화면 정렬 순서 (작을수록 위)
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// TASK FOLDER (태스크 그루핑용 폴더)
// folderId가 null인 태스크는 기본 그룹(미분류)으로 표시
// ────────────────────────────────────────────

model TaskFolder {
  id        String   @id @default(cuid())
  name      String
  /// 폴더 내 정렬 순서 (작을수록 위, 0=미설정)
  sortOrder Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([projectId])
  @@index([userId])
}

// ────────────────────────────────────────────
// TASK (세션 간 태스크 관리 + 핵심 결정 저장)
// ────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  /// 사람이 읽기 쉬운 순번. MCP tool에서 #42 형태로 참조.
  seq         Int        @unique @default(autoincrement())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  /// 작업 모듈 (예: "auth", "api", "ui"). 필터링에 사용.
  module      String?
  priority    Int        @default(0)
  /// UI 드래그앤드롭 수동 정렬 순서. 0=미설정(맨 뒤).
  sortOrder   Float      @default(0)
  /// finish_task 시 AI가 추출한 핵심 결정/인사이트 목록. recall 검색 대상.
  keyDecisions String[]   @default([])
  /// finish_task 시 AI가 자유 서술로 기록한 "실제로 무엇을 했는지"
  outcome      String?    @db.Text
  /// status 가 DONE/CANCELLED 로 바뀐 시각
  doneAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    TaskFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, module])
  @@index([projectId, folderId])
  @@index([userId])
}

// ────────────────────────────────────────────
// SESSION LOG (AI가 세션 종료 시 저장하는 작업 요약)
// ────────────────────────────────────────────

model SessionLog {
  id        String   @id @default(cuid())
  /// MCP 프로세스 기동 시 생성되는 UUID — 같은 세션의 여러 log_session 호출을 하나로 묶어요
  sessionId String?
  /// AI가 생성한 세션 요약
  summary   String   @db.Text
  /// 작업에 사용한 AI 도구 ("claude" | "cursor" | "gemini" | "codex")
  aiTool    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
}

// ────────────────────────────────────────────
// PLATFORM SKILL (Votra 팀 관리, 사용자 수정 불가)
// ────────────────────────────────────────────

model PlatformSkill {
  slug        String   @id
  name        String
  description String
  /// coding | process | analysis
  category    String   @default("coding")
  /// 에이전트 활성화 힌트 — brief에 목록으로 노출
  contextHint String
  /// 전체 MD 본문 (사용자 수정 불가)
  content     String   @db.Text
  /// Votra 팀이 전체 비활성화 가능
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configs ProjectSkillConfig[]
}

// ────────────────────────────────────────────
// PROJECT SKILL CONFIG (유저가 UI에서 켜고 끄는 상태)
// ────────────────────────────────────────────

model ProjectSkillConfig {
  id        String @id @default(cuid())
  /// 유저가 토글한 값. 기본값은 true (활성화)
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillSlug String
  skill     PlatformSkill @relation(fields: [skillSlug], references: [slug], onDelete: Cascade)

  @@unique([projectId, skillSlug])
  @@index([projectId])
}
