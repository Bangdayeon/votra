# Local dev: PostgreSQL connection string for Prisma
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/votra?schema=public"

# 세션 JWT 서명 시크릿 (32바이트 무작위 권장)
# 생성: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_STRING"

# 프로덕션은 axhub env 로 주입해요:
#   axhub env set DATABASE_URL --app votra --env production --from-stdin
