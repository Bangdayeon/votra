# Local dev: PostgreSQL connection string for Prisma
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haema?schema=public"

# 세션 JWT 서명 시크릿 (32바이트 무작위 권장)
# 생성: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_STRING"

# Google Gemini API key (개요 페이지 AI 요약 & 솔루션 생성용)
GEMINI_API_KEY="AIza..."

# Google OAuth (https://console.cloud.google.com → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID)
# 승인된 리디렉션 URI: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# 프로덕션은 axhub env 로 주입해요:
#   axhub env set DATABASE_URL --app haema --env production --from-stdin
#   axhub env set GEMINI_API_KEY --app haema --env production --from-stdin
